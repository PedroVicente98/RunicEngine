; Engine configuration file.
; A neutral Godot project for the Engine's RunicClient (GDB-1, slice 1): one Button, for the input checks. It holds no
; game content. The build copies it to <build>/godot/RunicClientProject, so Godot's .godot/ cache stays out of the
; sources.

config_version=5

[application]

config/name="RunicClient Test Project"
config/description="Neutral project for the Engine's RunicClient: one Button for the input checks."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648

[physics]

3d/physics_engine="Dummy"
2d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
