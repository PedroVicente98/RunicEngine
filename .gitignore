# Out-of-source CMake builds and generated tool state.
/build*/
/cmake-build-*/
/out/
# external/: Godot and godot-cpp are pinned submodules; everything else in it is downloaded by the build
# (pinned archives with SHA-256, the SCons environment) and never committed.
/external/*
!/external/README.md
!/external/godot
!/external/godot-cpp
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
CMakeUserPresets.json
.cache/
.clangd/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
# Keep shared VS Code/Cursor settings trackable; only ignore personal history/state.
.vscode/.browse.VC.db*
.vscode/ipch/
.history/
*.swp
*~
.DS_Store

# SCons cache of the Godot build (CI keeps it between runs).
/.scons-cache/
