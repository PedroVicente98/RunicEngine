# Link checks run at the end of configure (BUILD-1). Contract: cmake/README.md.
#
#   runic_mark_presentation(<target>...)   targets a headless target must never reach (libgodot, godot-cpp,
#                                          GodotBridge, GodotTools, an audio backend, editor code)
#   runic_check_headless(<target>...)      executables and libraries that must stay headless (GameServer)
#
# At the end of configure every target registered with runic_check_headless and every module created with
# HEADLESS has its full link closure walked (LINK_LIBRARIES and INTERFACE_LINK_LIBRARIES, through
# $<LINK_ONLY:...>). Reaching a marked target fails configure with the chain. The same pass checks the third
# parties each module links against its catalog row and the links of interface targets. When everything
# passes, configure prints "RUNIC: link checks passed (<n> targets)".
include_guard(GLOBAL)

function(runic_mark_presentation)
    set_property(GLOBAL APPEND PROPERTY RUNIC_PRESENTATION_TARGETS ${ARGN})
endfunction()

function(runic_check_headless)
    foreach(target IN LISTS ARGN)
        if(NOT TARGET ${target})
            runic_fatal( "RUNIC: runic_check_headless: '${target}' is not a target")
        endif()
    endforeach()
    set_property(GLOBAL APPEND PROPERTY RUNIC_HEADLESS_ROOTS ${ARGN})
endfunction()

# ---- helpers -----------------------------------------------------------------------------------------------

# The real target behind a name (aliases resolved), or "" when the name is not a target.
function(_runic_real_target name out_var)
    set(real "")
    if(TARGET "${name}")
        get_target_property(aliased "${name}" ALIASED_TARGET)
        if(aliased)
            set(real "${aliased}")
        else()
            set(real "${name}")
        endif()
    endif()
    set(${out_var} "${real}" PARENT_SCOPE)
endfunction()

# Turns one link item into a target name: drops CMake's ::@ directory markers, unwraps generator
# expressions such as $<LINK_ONLY:x> or $<$<CONFIG:Debug>:x>. Returns "" for items that cannot be targets.
function(_runic_link_item_name item out_var)
    set(name "")
    if(NOT item MATCHES "^::@")
        if(item MATCHES "^\\$<")
            string(REGEX MATCH "([A-Za-z0-9_.+-]+::)?[A-Za-z0-9_.+-]+>+$" unwrapped "${item}")
            string(REGEX REPLACE ">+$" "" name "${unwrapped}")
        else()
            set(name "${item}")
        endif()
    endif()
    set(${out_var} "${name}" PARENT_SCOPE)
endfunction()

# The link items of a target as written (display names), from LINK_LIBRARIES and INTERFACE_LINK_LIBRARIES.
function(_runic_target_links real out_var)
    set(items "")
    get_target_property(type ${real} TYPE)
    get_target_property(imported ${real} IMPORTED)
    if(NOT type STREQUAL "INTERFACE_LIBRARY" AND NOT imported)
        get_target_property(direct ${real} LINK_LIBRARIES)
        if(direct)
            list(APPEND items ${direct})
        endif()
    endif()
    get_target_property(interface ${real} INTERFACE_LINK_LIBRARIES)
    if(interface)
        list(APPEND items ${interface})
    endif()
    set(names "")
    foreach(item IN LISTS items)
        _runic_link_item_name("${item}" name)
        if(NOT name STREQUAL "")
            list(APPEND names "${name}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES names)
    set(${out_var} "${names}" PARENT_SCOPE)
endfunction()

# Breadth-first walk of the link closure of <root>. Sets <out_found> to the first presentation target
# reached ("" when none) and <out_chain> to the targets in between.
function(_runic_find_presentation root_display out_found out_chain)
    get_property(marked GLOBAL PROPERTY RUNIC_PRESENTATION_TARGETS)
    set(marked_real "")
    foreach(m IN LISTS marked)
        _runic_real_target("${m}" r)
        if(r)
            list(APPEND marked_real "${r}")
        endif()
    endforeach()

    _runic_real_target("${root_display}" root_real)
    set(queue_nodes "${root_real}")
    set(queue_paths "${root_display}")
    set(visited "")
    while(queue_nodes)
        list(POP_FRONT queue_nodes node)
        list(POP_FRONT queue_paths path)
        if(node IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${node}")
        _runic_target_links("${node}" links)
        foreach(dep IN LISTS links)
            _runic_real_target("${dep}" dep_real)
            if(NOT dep_real)
                continue()   # a plain library name or a flag: never a marked target
            endif()
            set(dep_path "${path}|${dep}")
            if(dep_real IN_LIST marked_real)
                string(REPLACE "|" ";" steps "${dep_path}")
                list(LENGTH steps count)
                if(count GREATER 2)
                    math(EXPR last "${count} - 2")
                    list(SUBLIST steps 1 ${last} middle)
                    list(JOIN middle " -> " chain)
                else()
                    set(chain "a direct link")
                endif()
                set(${out_found} "${dep}" PARENT_SCOPE)
                set(${out_chain} "${chain}" PARENT_SCOPE)
                return()
            endif()
            list(APPEND queue_nodes "${dep_real}")
            list(APPEND queue_paths "${dep_path}")
        endforeach()
    endwhile()
    set(${out_found} "" PARENT_SCOPE)
    set(${out_chain} "" PARENT_SCOPE)
endfunction()

# ---- the deferred pass -------------------------------------------------------------------------------------

function(_runic_run_link_checks)
    set(checked "")
    set(errors "")

    # 1. Third parties linked by modules: listed in the row, PUBLIC only with an approved exception, never an
    #    infrastructure library in an Engine module.
    get_property(pending GLOBAL PROPERTY RUNIC_PENDING_THIRD_PARTY)
    foreach(entry IN LISTS pending)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 module)
        list(GET fields 1 dep)
        list(GET fields 2 visibility)
        _runic_third_party_ids_for("${module}" "${dep}" ids)
        if(NOT ids)
            get_property(listed GLOBAL PROPERTY "RUNIC_CATALOG_${module}_THIRD_PARTY")
            list(JOIN listed ", " listed)
            if(NOT listed)
                set(listed "none")
            endif()
            list(APPEND errors
                "RUNIC: module ${module} links ${dep}, which is neither a module, an interface target nor a third party of its catalog row (THIRD_PARTY: ${listed})")
            continue()
        endif()
        if(visibility STREQUAL "PUBLIC")
            get_property(exceptions GLOBAL PROPERTY "RUNIC_CATALOG_${module}_PUBLIC_EXCEPTIONS")
            set(approved FALSE)
            foreach(exception IN LISTS exceptions)
                _runic_public_exception_library("${exception}" library)
                if(library IN_LIST ids)
                    set(approved TRUE)
                endif()
            endforeach()
            if(NOT approved)
                list(APPEND errors
                    "RUNIC: module ${module} links the third party ${dep} as PUBLIC without a PUBLIC_EXCEPTIONS entry in its catalog row: library types stay out of Public/ (link it PRIVATE)")
            endif()
        endif()
        if(module MATCHES "^Runic::")
            foreach(id IN LISTS ids)
                get_property(infrastructure GLOBAL PROPERTY "RUNIC_THIRD_PARTY_${id}_INFRASTRUCTURE")
                if(infrastructure)
                    list(APPEND errors
                        "RUNIC: Engine module ${module} links the infrastructure library ${dep} (${id}): the Engine never depends on Agones, Kubernetes, gRPC, NATS or databases")
                endif()
            endforeach()
        endif()
        list(APPEND checked "${module}")
    endforeach()

    # 2. Interface targets link Runic::Core only.
    get_property(interfaces GLOBAL PROPERTY RUNIC_INTERFACE_TARGETS)
    _runic_real_target("Runic::Core" core_real)
    foreach(interface IN LISTS interfaces)
        _runic_real_target("${interface}" real)
        get_target_property(links ${real} INTERFACE_LINK_LIBRARIES)
        if(links)
            foreach(item IN LISTS links)
                _runic_link_item_name("${item}" name)
                if(name STREQUAL "" OR name STREQUAL "Runic::Core")
                    continue()
                endif()
                _runic_real_target("${name}" name_real)
                if(core_real AND name_real STREQUAL core_real)
                    continue()
                endif()
                list(APPEND errors
                    "RUNIC: interface target ${interface} links ${name}: an interface target the Platform implements may link only Runic::Core")
            endforeach()
        endif()
        list(APPEND checked "${interface}")
    endforeach()

    # 3. Headless: registered roots (executables such as RunicGameServer) and every HEADLESS module.
    get_property(roots GLOBAL PROPERTY RUNIC_HEADLESS_ROOTS)
    get_property(headless_modules GLOBAL PROPERTY RUNIC_HEADLESS_MODULES)
    foreach(root IN LISTS roots headless_modules)
        _runic_find_presentation("${root}" found chain)
        if(found)
            list(APPEND errors
                "RUNIC: headless target ${root} reaches presentation target ${found} through ${chain}")
        endif()
        list(APPEND checked "${root}")
    endforeach()

    if(errors)
        list(JOIN errors "\n" text)
        runic_fatal("${text}")
    endif()
    list(REMOVE_DUPLICATES checked)
    list(LENGTH checked count)
    message(STATUS "RUNIC: link checks passed (${count} targets)")
endfunction()

# Schedule the pass once, in the top-level directory, after everything else has been configured.
get_property(_runic_checks_scheduled GLOBAL PROPERTY RUNIC_LINK_CHECKS_SCHEDULED)
if(NOT _runic_checks_scheduled)
    set_property(GLOBAL PROPERTY RUNIC_LINK_CHECKS_SCHEDULED TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _runic_run_link_checks)
endif()
unset(_runic_checks_scheduled)
