# Public-header scan (BUILD-1; RunicDocs › Modules, work packages and the implementation contract › Automated
# checks: "Library types in Public/, and Godot types outside GodotBridge and GodotTools").
#
#   cmake -DROOT=<repository> -DCATALOG=<catalog file> -P PublicHeaderScan.cmake
#
# Fails when
#   1. a header under a module's Public/ includes or names a third-party library, unless the module's catalog
#      row lists the matching approved exception (glm in Core, BehaviorTree.CPP node base types, godot-cpp
#      types in GodotTools). Flecs has no exception: the opt-in Runic::ECSNative target keeps its headers
#      outside Public/;
#   2. any file of a module includes or names Godot or godot-cpp, unless that module may use Godot: its row
#      lists godot-cpp or libgodot as a third party, or allows Runic::GodotTools (the game's editor library).
cmake_minimum_required(VERSION 3.24)
foreach(required ROOT CATALOG)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "PublicHeaderScan: -D${required}=... is required")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ScanCommon.cmake")
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/CatalogReader.cmake")
runic_read_catalog("${CATALOG}")

# _library(<id> <include regex> <name regex> <exception that lets it into Public/, or "">)
# A function, not a macro: macro arguments are re-parsed, which would change the backslashes of the regexes.
set(libraries "")
function(_library id include_re name_re exception)
    set(libraries ${libraries} "${id}" PARENT_SCOPE)
    set(LIB_${id}_INCLUDE "${include_re}" PARENT_SCOPE)
    set(LIB_${id}_NAME "${name_re}" PARENT_SCOPE)
    set(LIB_${id}_EXCEPTION "${exception}" PARENT_SCOPE)
endfunction()
_library(flecs "^flecs(\\.h|/)" "flecs::" "")
_library(glm "^glm/" "glm::" "glm")
_library(jolt "^Jolt/" "JPH::" "")
_library(godot-cpp "^(godot_cpp/|gdextension_interface\\.h)" "godot::" "godot-cpp")
_library(behaviortree "^behaviortree_cpp/" "BT::" "behaviortree-nodes")
_library(detour-recast "^(Detour|DetourTileCache|Recast)[A-Za-z]*\\.h" "(dtNavMesh|dtTileCache|rcContext)" "")
_library(gamenetworkingsockets "^steam/" "(ISteamNetworking|SteamNetworking)" "")
_library(grpc "^grpc(pp)?/" "grpc::" "")
_library(nats "^nats(\\.h|/)" "natsConnection" "")
_library(agones "^agones/" "agones::" "")
_library(protobuf "^google/protobuf/|\\.pb\\.h$" "google::protobuf" "")
_library(prometheus "^prometheus/" "prometheus::" "")
_library(zstd "^zstd\\.h$" "ZSTD_" "")
_library(meshoptimizer "^meshoptimizer\\.h$" "meshopt_" "")
_library(bgfx "^(bgfx|bx|bimg)/" "bgfx::" "")
_library(rmlui "^RmlUi/" "Rml::" "")
_library(imgui "^imgui" "ImGui::" "")
_library(glfw "^GLFW/" "glfw[A-Z]" "")

function(_scan_row_value module field out_var)
    set(value "")
    if(DEFINED CATALOG_${module}_${field})
        set(value "${CATALOG_${module}_${field}}")
    endif()
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

function(_scan_module_may_use_godot module out_var)
    _scan_row_value("${module}" THIRD_PARTY third)
    _scan_row_value("${module}" ALLOWS allows)
    set(may FALSE)
    if("godot-cpp" IN_LIST third OR "libgodot" IN_LIST third OR "Runic::GodotTools" IN_LIST allows)
        set(may TRUE)
    endif()
    set(${out_var} ${may} PARENT_SCOPE)
endfunction()

runic_scan_files("${ROOT}" files)
set(errors "")
foreach(file IN LISTS files)
    runic_scan_module_of("${file}" module)
    if(module STREQUAL "")
        continue()
    endif()
    set(in_public FALSE)
    if(file MATCHES "(^|/)${module}/Public/")
        set(in_public TRUE)
    endif()
    _scan_row_value("${module}" PUBLIC_EXCEPTIONS exceptions)
    _scan_module_may_use_godot("${module}" may_use_godot)
    runic_scan_includes("${ROOT}/${file}" includes)
    runic_scan_code("${ROOT}/${file}" code)

    foreach(library IN LISTS libraries)
        set(include_re "${LIB_${library}_INCLUDE}")
        set(name_re "${LIB_${library}_NAME}")
        set(exception "${LIB_${library}_EXCEPTION}")

        set(hit "")
        foreach(inc IN LISTS includes)
            if(inc MATCHES "${include_re}")
                set(hit "#include <${inc}>")
                break()
            endif()
        endforeach()
        if(hit STREQUAL "" AND NOT name_re STREQUAL "" AND code MATCHES "${name_re}")
            set(hit "${CMAKE_MATCH_0}")
        endif()
        if(hit STREQUAL "")
            continue()
        endif()

        if(library STREQUAL "godot-cpp" AND NOT may_use_godot)
            list(APPEND errors
                "RUNIC: ${file}: uses Godot (${hit}) in module ${module}: Godot and godot-cpp appear only in GodotBridge and GodotTools (and the game's editor library)")
            continue()
        endif()
        if(in_public)
            if(NOT exception STREQUAL "" AND exception IN_LIST exceptions)
                continue()
            endif()
            list(APPEND errors
                "RUNIC: ${file}: public header of ${module} uses the library ${library} (${hit}): library types stay in Source/ behind Runic types unless the catalog row lists an approved exception")
        endif()
    endforeach()
endforeach()

if(errors)
    runic_scan_fail("${errors}")
endif()
list(LENGTH files count)
message(STATUS "RUNIC: public-header scan passed (${count} files)")
