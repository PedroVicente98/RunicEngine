# CI hardening check (BUILD-1 security requirement, RunicDocs › Archive › Appendix Security): every GitHub
# Action is pinned to a full commit SHA, never a tag or a branch.
#
#   cmake -DROOT=<repository> -P WorkflowPinCheck.cmake
#
# Scans .github/workflows/*.yml and *.yaml. Local actions (uses: ./path) and docker:// images with a digest
# are allowed; anything else must be owner/repo[/path]@<40 hex characters>.
cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/ScanCommon.cmake")
if(NOT DEFINED ROOT)
    message(FATAL_ERROR "WorkflowPinCheck: -DROOT=... is required")
endif()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)
file(GLOB workflows "${ROOT}/.github/workflows/*.yml" "${ROOT}/.github/workflows/*.yaml")
set(errors "")
set(uses_count 0)
foreach(workflow IN LISTS workflows)
    file(RELATIVE_PATH rel "${ROOT}" "${workflow}")
    file(STRINGS "${workflow}" lines)
    set(number 0)
    foreach(line IN LISTS lines)
        math(EXPR number "${number} + 1")
        if(NOT line MATCHES "^[ \t-]*uses:[ \t]*['\"]?([^'\" \t#]+)")
            continue()
        endif()
        set(ref "${CMAKE_MATCH_1}")
        math(EXPR uses_count "${uses_count} + 1")
        if(ref MATCHES "^\\./")
            continue()
        endif()
        if(ref MATCHES "^docker://")
            if(NOT ref MATCHES "@sha256:[0-9a-f]+$")
                list(APPEND errors "RUNIC: ${rel}:${number}: ${ref} is not pinned by digest")
            endif()
            continue()
        endif()
        if(NOT ref MATCHES "@[0-9a-f]+$")
            list(APPEND errors "RUNIC: ${rel}:${number}: ${ref} is not pinned to a commit SHA")
            continue()
        endif()
        string(REGEX REPLACE "^.*@" "" sha "${ref}")
        string(LENGTH "${sha}" sha_length)
        if(NOT sha_length EQUAL 40)
            list(APPEND errors "RUNIC: ${rel}:${number}: ${ref} references an Action by tag or short SHA, pin the full 40-character commit SHA")
        endif()
    endforeach()
endforeach()

if(errors)
    runic_scan_fail("${errors}")
endif()
list(LENGTH workflows count)
message(STATUS "RUNIC: workflow pin check passed (${count} workflows, ${uses_count} actions)")
