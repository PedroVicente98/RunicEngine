# Catalog sync (BUILD-1): a repository's CMake catalog equals the dependency table of docs/system/03.
#
#   cmake -DCATALOG=<catalog file> -DDOCS=<03-dependency-rules.md> -DTABLE=<engine|platform|game>
#         -P CatalogSync.cmake
#
# Compared per row: the module exists on both sides, its allowed module dependencies (the "Depends on"
# column) and, in the Engine table, its group and Headless value. Third-party IDs are reviewed with the
# catalog, since the table names only some of them. Names are read the way the table writes them:
#   - parentheses and footnote markers are notes and are dropped; "Most modules" is ALLOWS_ANY_MODULE;
#   - Engine table: a bare name is Runic::<Name>;
#   - Platform table: a bare name is RunicPlatform::<Name>; only C++ rows ("(C++)" or a catalog row) count;
#   - Game table: a bare name before any Runic:: name is RunicGame::<Name>, after one it is Runic::<Name>;
#     "Platform server bindings and contracts" is RunicPlatform::ServerBindings and RunicPlatform::Contracts;
#   - a cell part that is not a single name (a sentence) is a note and is ignored.
cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/ScanCommon.cmake")
foreach(required CATALOG DOCS TABLE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "CatalogSync: -D${required}=... is required")
    endif()
endforeach()
if(NOT TABLE MATCHES "^(engine|platform|game)$")
    message(FATAL_ERROR "CatalogSync: TABLE must be engine, platform or game")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CatalogReader.cmake")
runic_read_catalog("${CATALOG}")

# ---- read the table ----------------------------------------------------------------------------------------
file(READ "${DOCS}" text)
string(REGEX REPLACE "\\[\\^[A-Za-z0-9_-]+\\]" "" text "${text}")   # footnote markers
string(REPLACE "[" "" text "${text}")
string(REPLACE "]" "" text "${text}")
string(REPLACE "`" "" text "${text}")
string(REPLACE ";" "%SEMI%" text "${text}")
string(REPLACE "\n" ";" lines "${text}")

if(TABLE STREQUAL "engine")
    set(heading "^## Engine modules")
    set(name_header "Module")
elseif(TABLE STREQUAL "platform")
    set(heading "^## Platform modules")
    set(name_header "Module")
else()
    set(heading "^## Game (modules|targets)")
    set(name_header "Target")
endif()

set(state "search")
set(rows "")
foreach(line IN LISTS lines)
    if(state STREQUAL "search")
        if(line MATCHES "${heading}")
            set(state "table")
        endif()
    elseif(state STREQUAL "table" OR state STREQUAL "rows")
        if(line MATCHES "^[ \t]*\\|")
            set(state "rows")
            list(APPEND rows "${line}")
        elseif(state STREQUAL "rows")
            break()
        endif()
    endif()
endforeach()
list(LENGTH rows row_count)
if(row_count LESS 3)
    message(FATAL_ERROR "RUNIC: catalog sync: no table found under '${heading}' in ${DOCS}")
endif()

function(_split_row line out_var)
    string(REGEX REPLACE "^[ \t]*\\|" "" line "${line}")
    string(REGEX REPLACE "\\|[ \t]*$" "" line "${line}")
    string(REPLACE "|" ";" cells "${line}")
    set(trimmed "")
    foreach(cell IN LISTS cells)
        string(STRIP "${cell}" cell)
        list(APPEND trimmed "${cell}")
    endforeach()
    set(${out_var} "${trimmed}" PARENT_SCOPE)
endfunction()

list(GET rows 0 header_line)
_split_row("${header_line}" header)
list(FIND header "${name_header}" name_col)
list(FIND header "Depends on" deps_col)
list(FIND header "Group" group_col)
list(FIND header "Headless" headless_col)
if(name_col LESS 0 OR deps_col LESS 0)
    message(FATAL_ERROR "RUNIC: catalog sync: the table under '${heading}' has no '${name_header}' or 'Depends on' column")
endif()

# Parses a "Depends on" cell into full target names; sets <out_any> when it says "Most modules".
function(_parse_deps cell out_var out_any)
    string(REGEX REPLACE "\\([^)]*\\)" "" cell "${cell}")
    string(REPLACE "%SEMI%" "," cell "${cell}")
    string(REPLACE "Platform server bindings and contracts" "RunicPlatform::ServerBindings, RunicPlatform::Contracts" cell "${cell}")
    string(REPLACE "Engine interface targets only:" "" cell "${cell}")
    set(any FALSE)
    if(cell MATCHES "Most modules")
        set(any TRUE)
        string(REPLACE "Most modules" "" cell "${cell}")
    endif()
    string(REPLACE "," ";" tokens "${cell}")
    set(names "")
    set(context "")
    foreach(token IN LISTS tokens)
        string(STRIP "${token}" token)
        if(token MATCHES "^(Runic|RunicPlatform|RunicGame)::([A-Za-z]+)$")
            list(APPEND names "${token}")
            set(context "${CMAKE_MATCH_1}")
        elseif(token MATCHES "^[A-Z][A-Za-z]*$")
            if(TABLE STREQUAL "engine")
                list(APPEND names "Runic::${token}")
            elseif(TABLE STREQUAL "platform")
                list(APPEND names "RunicPlatform::${token}")
            elseif(context STREQUAL "")
                list(APPEND names "RunicGame::${token}")
            else()
                list(APPEND names "${context}::${token}")
            endif()
        endif()   # anything else ("—", a sentence) is a note
    endforeach()
    list(REMOVE_DUPLICATES names)
    list(SORT names)
    set(${out_var} "${names}" PARENT_SCOPE)
    set(${out_any} ${any} PARENT_SCOPE)
endfunction()

function(_normalize_word value out_var)
    string(REGEX REPLACE "\\([^)]*\\)" "" value "${value}")
    string(STRIP "${value}" value)
    string(TOLOWER "${value}" value)
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

# ---- compare -----------------------------------------------------------------------------------------------
set(errors "")
set(doc_names "")
math(EXPR last "${row_count} - 1")
foreach(i RANGE 2 ${last})
    list(GET rows ${i} line)
    _split_row("${line}" cells)
    list(LENGTH cells n)
    if(n LESS_EQUAL deps_col OR n LESS_EQUAL name_col)
        continue()
    endif()
    list(GET cells ${name_col} raw_name)
    list(GET cells ${deps_col} deps_cell)

    set(is_cpp FALSE)
    if(raw_name MATCHES "\\(C\\+\\+\\)")
        set(is_cpp TRUE)
    endif()
    string(REGEX REPLACE "\\([^)]*\\)" "" name "${raw_name}")
    string(STRIP "${name}" name)
    if(TABLE STREQUAL "engine")
        string(REGEX REPLACE "^Runic::" "" name "${name}")
    elseif(TABLE STREQUAL "game")
        if(NOT name MATCHES "^RunicGame::")
            continue()   # executables, Go services and content are not catalog rows
        endif()
        string(REGEX REPLACE "^RunicGame::" "" name "${name}")
    else()
        string(REGEX REPLACE "[ \t]+" ";" words "${name}")
        set(name "")
        foreach(word IN LISTS words)
            string(SUBSTRING "${word}" 0 1 first)
            string(SUBSTRING "${word}" 1 -1 rest)
            string(TOUPPER "${first}" first)
            string(APPEND name "${first}${rest}")
        endforeach()
        if(NOT name IN_LIST CATALOG_NAMES AND NOT is_cpp)
            continue()   # Go and infrastructure rows are not CMake targets
        endif()
    endif()
    if(NOT name MATCHES "^[A-Za-z]+$")
        continue()
    endif()
    list(APPEND doc_names "${name}")

    if(NOT name IN_LIST CATALOG_NAMES)
        list(APPEND errors "RUNIC: catalog sync: ${name} is in the table of ${DOCS} but not in ${CATALOG}")
        continue()
    endif()

    _parse_deps("${deps_cell}" doc_deps doc_any)
    set(cat_deps "${CATALOG_${name}_ALLOWS}")
    list(REMOVE_DUPLICATES cat_deps)
    list(SORT cat_deps)
    if(NOT "${doc_deps}" STREQUAL "${cat_deps}")
        string(REPLACE ";" ", " a "${cat_deps}")
        string(REPLACE ";" ", " b "${doc_deps}")
        list(APPEND errors "RUNIC: catalog sync: ${name} allows [${a}] in the catalog but [${b}] in the table")
    endif()
    set(cat_any FALSE)
    if(CATALOG_${name}_ALLOWS_ANY_MODULE)
        set(cat_any TRUE)
    endif()
    if(NOT cat_any STREQUAL doc_any)
        list(APPEND errors "RUNIC: catalog sync: ${name}: ALLOWS_ANY_MODULE is ${cat_any} in the catalog, 'Most modules' is ${doc_any} in the table")
    endif()

    if(TABLE STREQUAL "engine")
        if(group_col GREATER_EQUAL 0)
            list(GET cells ${group_col} doc_group)
            string(REPLACE " " "" doc_group "${doc_group}")
            string(TOLOWER "${doc_group}" doc_group)
            string(TOLOWER "${CATALOG_${name}_GROUP}" cat_group)
            if(NOT doc_group STREQUAL cat_group)
                list(APPEND errors "RUNIC: catalog sync: ${name} is in group ${CATALOG_${name}_GROUP} in the catalog but ${doc_group} in the table")
            endif()
        endif()
        if(headless_col GREATER_EQUAL 0)
            list(GET cells ${headless_col} doc_headless)
            _normalize_word("${doc_headless}" doc_headless)
            string(REPLACE " " "-" doc_headless "${doc_headless}")
            if(NOT doc_headless STREQUAL CATALOG_${name}_HEADLESS)
                list(APPEND errors "RUNIC: catalog sync: ${name} is headless '${CATALOG_${name}_HEADLESS}' in the catalog but '${doc_headless}' in the table")
            endif()
        endif()
    endif()
endforeach()

foreach(name IN LISTS CATALOG_NAMES)
    if(NOT name IN_LIST doc_names)
        list(APPEND errors "RUNIC: catalog sync: ${name} is in ${CATALOG} but not in the table of ${DOCS}")
    endif()
endforeach()

if(errors)
    runic_scan_fail("${errors}")
endif()
list(LENGTH CATALOG_NAMES count)
message(STATUS "RUNIC: catalog sync passed (${count} rows, ${TABLE} table)")
