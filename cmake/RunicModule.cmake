# The module helpers of the three repositories (BUILD-1). Contract: cmake/README.md; rules: RunicDocs ›
# Modules, work packages and the implementation contract (Module contract, Dependency rules).
#
#   runic_catalog_module(<Name> GROUP <g> [ALLOWS <target>...] [THIRD_PARTY <id-or-target>...]
#                        [PUBLIC_EXCEPTIONS <id>...] [ALLOWS_ANY_MODULE] HEADLESS <yes|no|tool|never-shipped>)
#   runic_catalog_interface(<Name> FROM <Module>)
#   runic_third_party(<id> TARGETS <target>... [PRESENTATION] [INFRASTRUCTURE])
#   runic_add_module(<Name> GROUP <g> [PUBLIC_DEPS <t>...] [PRIVATE_DEPS <t>...] [HEADLESS])
#   runic_add_interface_target(<Name> FROM <Module> HEADERS <dir>)
#   runic_add_group(<Group> MODULES <target>...)
#   runic_add_catalog_modules(ROOT <dir> LAYOUT <GROUP|NAME> [FOLDERS <Name>=<dir>...]
#                             [PRESENTATION <bool>] [TOOLS <bool>] [MODULES <name>...|ALL])     (BUILD-2)
#
# A consumer gets them with list(APPEND CMAKE_MODULE_PATH "${RUNIC_ENGINE_DIR}/cmake") and include(RunicModule);
# RunicPlatform and RunicGame get them through the Engine they add. The namespace of the targets a directory
# creates comes from RUNIC_MODULE_NAMESPACE in that directory (Runic, RunicPlatform, RunicGame).
# Every failure starts with "RUNIC:" and names the module, the offending target and the catalog row.
include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/RunicToolchain.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RunicChecks.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RunicTesting.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RunicThirdParty.cmake")

# The three approved public-header exceptions and the library each one lets through (RunicDocs › Module
# contract, decided 2026-11-12): GLM math types in Core, BehaviorTree.CPP node base types for Game custom AI nodes,
# godot-cpp types in GodotTools. Flecs has none: the Flecs world is reachable only through Runic::ECSNative (ECS-1).
# Constants live inside functions: this file is included once (include_guard), from whichever directory
# comes first, so a directory-scope variable would be invisible to the Platform's and the Game's scopes.
function(_runic_public_exceptions out_ids out_libraries)
    set(${out_ids} "glm" "behaviortree-nodes" "godot-cpp" PARENT_SCOPE)
    set(${out_libraries} "glm" "behaviortree" "godot-cpp" PARENT_SCOPE)
endfunction()

function(_runic_public_exception_library exception out_var)
    _runic_public_exceptions(ids libraries)
    list(FIND ids "${exception}" index)
    set(library "")
    if(index GREATER_EQUAL 0)
        list(GET libraries ${index} library)
    endif()
    set(${out_var} "${library}" PARENT_SCOPE)
endfunction()

function(_runic_namespace out_var)
    if(DEFINED RUNIC_MODULE_NAMESPACE AND NOT RUNIC_MODULE_NAMESPACE STREQUAL "")
        set(${out_var} "${RUNIC_MODULE_NAMESPACE}" PARENT_SCOPE)
    else()
        set(${out_var} "Runic" PARENT_SCOPE)
    endif()
endfunction()

# ---- catalog -----------------------------------------------------------------------------------------------

function(runic_catalog_module name)
    cmake_parse_arguments(ROW "ALLOWS_ANY_MODULE" "GROUP;HEADLESS" "ALLOWS;THIRD_PARTY;PUBLIC_EXCEPTIONS" ${ARGN})
    _runic_namespace(ns)
    set(key "${ns}::${name}")
    if(ROW_UNPARSED_ARGUMENTS)
        runic_fatal( "RUNIC: catalog row ${key}: unexpected arguments '${ROW_UNPARSED_ARGUMENTS}'")
    endif()
    if(NOT ROW_GROUP)
        runic_fatal( "RUNIC: catalog row ${key} has no GROUP")
    endif()
    if(NOT ROW_HEADLESS MATCHES "^(yes|no|tool|never-shipped)$")
        runic_fatal( "RUNIC: catalog row ${key}: HEADLESS must be yes, no, tool or never-shipped")
    endif()
    _runic_public_exceptions(approved_exceptions unused)
    foreach(exception IN LISTS ROW_PUBLIC_EXCEPTIONS)
        if(NOT exception IN_LIST approved_exceptions)
            list(JOIN approved_exceptions ", " approved_text)
            runic_fatal(
                "RUNIC: catalog row ${key}: '${exception}' is not an approved public-header exception (${approved_text})")
        endif()
    endforeach()
    get_property(exists GLOBAL PROPERTY "RUNIC_CATALOG_${key}_GROUP" SET)
    if(exists)
        runic_fatal( "RUNIC: catalog row ${key} is declared twice")
    endif()
    set_property(GLOBAL PROPERTY "RUNIC_CATALOG_${key}_GROUP" "${ROW_GROUP}")
    set_property(GLOBAL PROPERTY "RUNIC_CATALOG_${key}_ALLOWS" "${ROW_ALLOWS}")
    set_property(GLOBAL PROPERTY "RUNIC_CATALOG_${key}_THIRD_PARTY" "${ROW_THIRD_PARTY}")
    set_property(GLOBAL PROPERTY "RUNIC_CATALOG_${key}_PUBLIC_EXCEPTIONS" "${ROW_PUBLIC_EXCEPTIONS}")
    set_property(GLOBAL PROPERTY "RUNIC_CATALOG_${key}_ALLOWS_ANY_MODULE" "${ROW_ALLOWS_ANY_MODULE}")
    set_property(GLOBAL PROPERTY "RUNIC_CATALOG_${key}_HEADLESS" "${ROW_HEADLESS}")
    set_property(GLOBAL APPEND PROPERTY RUNIC_CATALOG_MODULES "${key}")
endfunction()

function(runic_catalog_interface name)
    cmake_parse_arguments(ROW "" "FROM" "" ${ARGN})
    _runic_namespace(ns)
    set(key "${ns}::${name}")
    if(NOT ROW_FROM)
        runic_fatal( "RUNIC: catalog interface ${key} has no FROM module")
    endif()
    set_property(GLOBAL PROPERTY "RUNIC_CATALOG_IFACE_${key}_FROM" "${ROW_FROM}")
    set_property(GLOBAL APPEND PROPERTY RUNIC_CATALOG_INTERFACES "${key}")
endfunction()

function(runic_third_party id)
    cmake_parse_arguments(TP "PRESENTATION;INFRASTRUCTURE" "" "TARGETS" ${ARGN})
    if(NOT TP_TARGETS)
        runic_fatal( "RUNIC: runic_third_party(${id}) needs TARGETS")
    endif()
    set_property(GLOBAL APPEND PROPERTY "RUNIC_THIRD_PARTY_${id}_TARGETS" ${TP_TARGETS})
    set_property(GLOBAL APPEND PROPERTY RUNIC_THIRD_PARTY_IDS "${id}")
    if(TP_PRESENTATION)
        runic_mark_presentation(${TP_TARGETS})
    endif()
    if(TP_INFRASTRUCTURE)
        set_property(GLOBAL PROPERTY "RUNIC_THIRD_PARTY_${id}_INFRASTRUCTURE" TRUE)
    endif()
endfunction()

# The library IDs of a module's catalog row that cover <dep>: the dep listed by target name, or an ID whose
# registered targets include it.
function(_runic_third_party_ids_for module dep out_var)
    get_property(row GLOBAL PROPERTY "RUNIC_CATALOG_${module}_THIRD_PARTY")
    get_property(all_ids GLOBAL PROPERTY RUNIC_THIRD_PARTY_IDS)
    list(REMOVE_DUPLICATES all_ids)
    _runic_real_target("${dep}" dep_real)
    set(ids "")
    if(dep IN_LIST row)
        list(APPEND ids "${dep}")
    endif()
    foreach(id IN LISTS all_ids)
        get_property(targets GLOBAL PROPERTY "RUNIC_THIRD_PARTY_${id}_TARGETS")
        set(match FALSE)
        foreach(t IN LISTS targets)
            _runic_real_target("${t}" t_real)
            if(t STREQUAL dep OR (dep_real AND t_real STREQUAL dep_real))
                set(match TRUE)
            endif()
        endforeach()
        if(match AND (id IN_LIST row OR dep IN_LIST row))
            list(APPEND ids "${id}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES ids)
    set(${out_var} "${ids}" PARENT_SCOPE)
endfunction()

function(_runic_is_runic_name name out_var)
    get_property(is_module GLOBAL PROPERTY "RUNIC_CATALOG_${name}_GROUP" SET)
    get_property(is_interface GLOBAL PROPERTY "RUNIC_CATALOG_IFACE_${name}_FROM" SET)
    get_property(is_group GLOBAL PROPERTY "RUNIC_GROUP_${name}" SET)
    if(is_module OR is_interface OR is_group)
        set(${out_var} TRUE PARENT_SCOPE)
    else()
        set(${out_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

# Direction, then the row's ALLOWS ceiling for modules; third parties are checked at the end of configure.
function(_runic_check_module_dependency module dep visibility)
    string(REGEX MATCH "^[^:]+" module_ns "${module}")
    if(module_ns STREQUAL "Runic" AND dep MATCHES "^(RunicPlatform|RunicGame)::")
        runic_fatal(
            "RUNIC: Engine module ${module} links ${dep}: wrong direction, the Engine never depends on RunicPlatform or RunicGame (the Platform implements Engine interfaces; the Game composes both)")
    endif()
    if(module_ns STREQUAL "RunicPlatform" AND dep MATCHES "^RunicGame::")
        runic_fatal(
            "RUNIC: Platform module ${module} links ${dep}: wrong direction, the Platform never depends on RunicGame")
    endif()

    get_property(allows GLOBAL PROPERTY "RUNIC_CATALOG_${module}_ALLOWS")
    get_property(any GLOBAL PROPERTY "RUNIC_CATALOG_${module}_ALLOWS_ANY_MODULE")
    _runic_is_runic_name("${dep}" is_runic)
    if(dep IN_LIST allows)
        return()
    endif()
    if(any AND is_runic)
        return()
    endif()
    if(is_runic)
        list(JOIN allows ", " allows)
        if(NOT allows)
            set(allows "none")
        endif()
        runic_fatal(
            "RUNIC: module ${module} links ${dep}, which its catalog row does not allow (ALLOWS: ${allows}); widening a row is an owner decision recorded in the architecture first")
    endif()
    set_property(GLOBAL APPEND PROPERTY RUNIC_PENDING_THIRD_PARTY "${module}|${dep}|${visibility}")
endfunction()

# ---- modules -----------------------------------------------------------------------------------------------

function(runic_add_module name)
    cmake_parse_arguments(M "HEADLESS" "GROUP" "PUBLIC_DEPS;PRIVATE_DEPS" ${ARGN})
    _runic_namespace(ns)
    set(full "${ns}::${name}")
    if(M_UNPARSED_ARGUMENTS)
        runic_fatal( "RUNIC: runic_add_module(${full}): unexpected arguments '${M_UNPARSED_ARGUMENTS}'")
    endif()

    get_property(in_catalog GLOBAL PROPERTY "RUNIC_CATALOG_${full}_GROUP" SET)
    if(NOT in_catalog)
        runic_fatal(
            "RUNIC: module ${full} is not in the catalog; a module needs its catalog row before it can be created (an owner decision recorded in the architecture first)")
    endif()
    get_property(row_group GLOBAL PROPERTY "RUNIC_CATALOG_${full}_GROUP")
    if(NOT M_GROUP STREQUAL row_group)
        runic_fatal( "RUNIC: module ${full} declares GROUP '${M_GROUP}' but its catalog row says '${row_group}'")
    endif()
    get_property(row_headless GLOBAL PROPERTY "RUNIC_CATALOG_${full}_HEADLESS")
    if(M_HEADLESS AND NOT row_headless STREQUAL "yes")
        runic_fatal( "RUNIC: module ${full} declares HEADLESS but its catalog row says '${row_headless}'")
    endif()
    if(NOT M_HEADLESS AND row_headless STREQUAL "yes")
        runic_fatal( "RUNIC: module ${full} is headless in its catalog row; declare HEADLESS")
    endif()

    string(TOLOWER "${ns}_${name}" target)
    set(dir "${CMAKE_CURRENT_SOURCE_DIR}")
    file(GLOB_RECURSE sources CONFIGURE_DEPENDS "${dir}/Source/*.cpp")
    file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${dir}/Public/*.hpp" "${dir}/Public/*.h"
                                                "${dir}/Source/*.hpp" "${dir}/Source/*.h")
    if(sources)
        add_library(${target} STATIC ${sources} ${headers})
        target_include_directories(${target}
            PUBLIC "$<BUILD_INTERFACE:${dir}/Public>"
            PRIVATE "${dir}/Source")
        set(public_kw PUBLIC)
        set(private_kw PRIVATE)
    else()
        add_library(${target} INTERFACE ${headers})
        target_include_directories(${target} INTERFACE "$<BUILD_INTERFACE:${dir}/Public>")
        set(public_kw INTERFACE)    # a header-only module has no private part
        set(private_kw INTERFACE)
    endif()
    add_library(${full} ALIAS ${target})
    set_target_properties(${target} PROPERTIES RUNIC_MODULE "${full}" RUNIC_MODULE_GROUP "${M_GROUP}")
    runic_apply_toolchain(${target})
    if(IS_DIRECTORY "${dir}/Public")
        set_property(GLOBAL APPEND PROPERTY RUNIC_PUBLIC_ROOTS "${full}|${dir}/Public")
    endif()

    # Third parties by need (BUILD-2): a dependency naming a recipe ID or one of its targets brings that recipe in
    # once, when the row lists it; an ID stands for the recipe's targets. A third party the row does not list is
    # never fetched, and the end-of-configure check reports the link.
    get_property(row_third_party GLOBAL PROPERTY "RUNIC_CATALOG_${full}_THIRD_PARTY")
    foreach(visibility PUBLIC PRIVATE)
        set(resolved "")
        foreach(dep IN LISTS M_${visibility}_DEPS)
            _runic_recipe_for("${dep}" recipe)
            if(recipe AND (recipe IN_LIST row_third_party OR dep IN_LIST row_third_party))
                runic_require_third_party(${recipe})
                if(dep STREQUAL recipe)
                    get_property(recipe_targets GLOBAL PROPERTY "RUNIC_RECIPE_${recipe}_TARGETS")
                    list(APPEND resolved ${recipe_targets})
                    continue()
                endif()
            endif()
            list(APPEND resolved "${dep}")
        endforeach()
        set(M_${visibility}_DEPS ${resolved})
    endforeach()

    foreach(visibility PUBLIC PRIVATE)
        foreach(dep IN LISTS M_${visibility}_DEPS)
            _runic_check_module_dependency("${full}" "${dep}" "${visibility}")
        endforeach()
    endforeach()
    if(M_PUBLIC_DEPS)
        target_link_libraries(${target} ${public_kw} ${M_PUBLIC_DEPS})
    endif()
    if(M_PRIVATE_DEPS)
        target_link_libraries(${target} ${private_kw} ${M_PRIVATE_DEPS})
    endif()

    set_property(GLOBAL APPEND PROPERTY RUNIC_MODULE_TARGETS "${full}")
    if(M_HEADLESS)
        set_property(GLOBAL APPEND PROPERTY RUNIC_HEADLESS_MODULES "${full}")
    else()
        runic_mark_presentation(${full})   # no, tool or never-shipped: never reached by a headless target
    endif()

    get_property(tests_enabled GLOBAL PROPERTY RUNIC_TESTS_ENABLED)
    file(GLOB_RECURSE test_sources CONFIGURE_DEPENDS "${dir}/Tests/*.cpp")
    if(tests_enabled AND test_sources)
        set(test_target "${ns}${name}Tests")
        add_executable(${test_target} ${test_sources})
        target_include_directories(${test_target} PRIVATE "${dir}/Tests")
        target_link_libraries(${test_target} PRIVATE ${full} GTest::gtest_main GTest::gmock)
        runic_apply_toolchain(${test_target})
        gtest_discover_tests(${test_target} DISCOVERY_MODE PRE_TEST PROPERTIES LABELS module)
        set_property(GLOBAL APPEND PROPERTY RUNIC_MODULE_TEST_TARGETS "${test_target}")
    endif()
endfunction()

function(runic_add_interface_target name)
    cmake_parse_arguments(I "" "FROM;HEADERS" "" ${ARGN})
    _runic_namespace(ns)
    set(full "${ns}::${name}")
    get_property(row_set GLOBAL PROPERTY "RUNIC_CATALOG_IFACE_${full}_FROM" SET)
    if(NOT row_set)
        runic_fatal( "RUNIC: interface target ${full} has no runic_catalog_interface row")
    endif()
    get_property(row_from GLOBAL PROPERTY "RUNIC_CATALOG_IFACE_${full}_FROM")
    if(NOT I_FROM STREQUAL row_from)
        runic_fatal( "RUNIC: interface target ${full} comes FROM ${I_FROM}; its catalog row says ${row_from}")
    endif()
    if(NOT I_HEADERS OR NOT IS_DIRECTORY "${I_HEADERS}")
        runic_fatal( "RUNIC: interface target ${full}: HEADERS '${I_HEADERS}' is not a directory")
    endif()
    string(TOLOWER "${ns}_${name}" target)
    add_library(${target} INTERFACE)
    add_library(${full} ALIAS ${target})
    target_include_directories(${target} INTERFACE "$<BUILD_INTERFACE:${I_HEADERS}>")
    target_compile_features(${target} INTERFACE cxx_std_20)
    if(TARGET Runic::Core)
        target_link_libraries(${target} INTERFACE Runic::Core)
    endif()
    get_filename_component(headers_dir "${I_HEADERS}" ABSOLUTE)
    set_property(GLOBAL APPEND PROPERTY RUNIC_INTERFACE_TARGETS "${full}")
    set_property(GLOBAL APPEND PROPERTY RUNIC_PUBLIC_ROOTS "${full}|${headers_dir}")
endfunction()

function(runic_add_group group)
    cmake_parse_arguments(G "" "" "MODULES" ${ARGN})
    _runic_namespace(ns)
    set(full "${ns}::${group}")
    foreach(module IN LISTS G_MODULES)
        get_property(is_module GLOBAL PROPERTY "RUNIC_CATALOG_${module}_GROUP" SET)
        if(NOT is_module)
            runic_fatal( "RUNIC: group ${full} lists ${module}, which is not a catalogued module")
        endif()
    endforeach()
    string(TOLOWER "${ns}_${group}" target)
    add_library(${target} INTERFACE)
    add_library(${full} ALIAS ${target})
    target_link_libraries(${target} INTERFACE ${G_MODULES})
    set_property(GLOBAL PROPERTY "RUNIC_GROUP_${full}" TRUE)
endfunction()

# ---- modules from the catalog (BUILD-2) --------------------------------------------------------------------
#
#   runic_add_catalog_modules(ROOT <dir> LAYOUT <GROUP|NAME> [FOLDERS <Name>=<dir>...]
#                             [PRESENTATION <bool>] [TOOLS <bool>] [MODULES <name>...|ALL])
#
# Adds every catalogued module of the calling directory's namespace whose folder has a CMakeLists.txt, in catalog
# order, so a module joins the build by adding only its own CMakeLists.txt (decided by the owner on 2026-11-12):
#   - Folder: <ROOT>/<Group>/<Name>/ (LAYOUT GROUP, the Engine) or <ROOT>/<Name>/ (LAYOUT NAME, the Platform and the
#     Game). FOLDERS gives a module another folder, relative to the calling directory.
#   - Build options: a row whose Headless value is "no" needs PRESENTATION; "tool" and "never-shipped" need TOOLS.
#   - MODULES limits the build to the listed modules and interface targets plus everything their rows allow, and so
#     on (the closure); given with no value it means none; ALL (or no MODULES) means every row.
#   - Interface targets: each catalogued interface target whose folder <module folder>/<Name>/ has a CMakeLists.txt
#     (calling runic_add_interface_target), whether or not its module is configured.
#   - Groups (LAYOUT GROUP): the umbrella target <Namespace>::<Group> of each group with a configured module, linking
#     those modules (Runic::GameplayAPI).
#   - LAYOUT GROUP: a CMakeLists.txt in <ROOT>/<Group>/<Name>/ with no matching catalog row fails configure.
function(runic_add_catalog_modules)
    cmake_parse_arguments(D "" "ROOT;LAYOUT;PRESENTATION;TOOLS" "FOLDERS;MODULES" ${ARGN})
    _runic_namespace(ns)
    if(D_UNPARSED_ARGUMENTS)
        runic_fatal("RUNIC: runic_add_catalog_modules: unexpected arguments '${D_UNPARSED_ARGUMENTS}'")
    endif()
    if(NOT D_ROOT OR NOT D_LAYOUT MATCHES "^(GROUP|NAME)$")
        runic_fatal("RUNIC: runic_add_catalog_modules needs ROOT <dir> and LAYOUT GROUP or NAME")
    endif()
    get_filename_component(root "${D_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")

    # This namespace's rows in catalog order, their groups, and the folder of each module.
    get_property(all_rows GLOBAL PROPERTY RUNIC_CATALOG_MODULES)
    get_property(all_interfaces GLOBAL PROPERTY RUNIC_CATALOG_INTERFACES)
    set(rows "")
    set(groups "")
    foreach(key IN LISTS all_rows)
        if(NOT key MATCHES "^${ns}::(.+)$")
            continue()
        endif()
        set(name "${CMAKE_MATCH_1}")
        get_property(group GLOBAL PROPERTY "RUNIC_CATALOG_${key}_GROUP")
        list(APPEND rows "${key}")
        list(APPEND groups "${group}")
        if(D_LAYOUT STREQUAL "GROUP")
            set(folder_${name} "${root}/${group}/${name}")
        else()
            set(folder_${name} "${root}/${name}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES groups)
    set(interfaces "")
    foreach(key IN LISTS all_interfaces)
        if(key MATCHES "^${ns}::")
            list(APPEND interfaces "${key}")
        endif()
    endforeach()
    foreach(entry IN LISTS D_FOLDERS)
        if(NOT entry MATCHES "^([^=]+)=(.+)$")
            runic_fatal("RUNIC: runic_add_catalog_modules: FOLDERS entry '${entry}' is not <Name>=<dir>")
        endif()
        set(name "${CMAKE_MATCH_1}")
        set(dir "${CMAKE_MATCH_2}")
        if(NOT "${ns}::${name}" IN_LIST rows)
            runic_fatal("RUNIC: runic_add_catalog_modules: FOLDERS names ${ns}::${name}, which has no catalog row")
        endif()
        get_filename_component(folder_${name} "${dir}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endforeach()

    # A module folder needs its row: a CMakeLists.txt in a group folder that no row names fails, instead of being
    # skipped without a word.
    if(D_LAYOUT STREQUAL "GROUP")
        file(GLOB lists RELATIVE "${root}" "${root}/*/*/CMakeLists.txt")
        foreach(rel IN LISTS lists)
            if(NOT rel MATCHES "^([^/]+)/([^/]+)/CMakeLists\\.txt$")
                continue()
            endif()
            set(group "${CMAKE_MATCH_1}")
            set(key "${ns}::${CMAKE_MATCH_2}")
            if(NOT group IN_LIST groups)
                continue()   # not a module group (Engine/Programs/)
            endif()
            file(RELATIVE_PATH shown "${PROJECT_SOURCE_DIR}" "${root}/${rel}")
            if(NOT key IN_LIST rows)
                runic_fatal(
                    "RUNIC: ${shown} has no catalog row: module ${key} needs its row first (an owner decision recorded in the architecture)")
            endif()
            get_property(row_group GLOBAL PROPERTY "RUNIC_CATALOG_${key}_GROUP")
            if(NOT row_group STREQUAL group)
                runic_fatal("RUNIC: ${shown}: module ${key} belongs to the group ${row_group} (its catalog row), not ${group}")
            endif()
        endforeach()
    endif()

    # Which rows this build may configure.
    if("MODULES" IN_LIST D_KEYWORDS_MISSING_VALUES)
        set(selected "")
    elseif(NOT DEFINED D_MODULES OR "ALL" IN_LIST D_MODULES)
        set(selected ${rows} ${interfaces})
    else()
        set(queue "")
        foreach(name IN LISTS D_MODULES)
            set(key "${ns}::${name}")
            if(name MATCHES "::")
                set(key "${name}")
            endif()
            if(NOT key IN_LIST rows AND NOT key IN_LIST interfaces)
                runic_fatal("RUNIC: MODULES names ${name}, which is neither a module nor an interface target of the ${ns} catalog")
            endif()
            list(APPEND queue "${key}")
        endforeach()
        set(selected "")
        while(queue)
            list(POP_FRONT queue key)
            if(key IN_LIST selected)
                continue()
            endif()
            list(APPEND selected "${key}")
            if(key IN_LIST interfaces)
                set(next "${ns}::Core")   # an interface target links Core only
            else()
                get_property(any GLOBAL PROPERTY "RUNIC_CATALOG_${key}_ALLOWS_ANY_MODULE")
                get_property(next GLOBAL PROPERTY "RUNIC_CATALOG_${key}_ALLOWS")
                if(any)
                    list(APPEND next ${rows})
                endif()
            endif()
            foreach(dep IN LISTS next)
                if(dep IN_LIST rows OR dep IN_LIST interfaces)
                    list(APPEND queue "${dep}")
                endif()
            endforeach()
        endwhile()
    endif()

    # Modules, then interface targets (they link Runic::Core when it exists), then the group umbrellas.
    set(added "")
    set(not_built "")
    foreach(key IN LISTS rows)
        string(REGEX REPLACE "^[^:]+::" "" name "${key}")
        if(NOT key IN_LIST selected OR NOT EXISTS "${folder_${name}}/CMakeLists.txt")
            continue()
        endif()
        get_property(headless GLOBAL PROPERTY "RUNIC_CATALOG_${key}_HEADLESS")
        if((headless STREQUAL "no" AND NOT D_PRESENTATION)
                OR (headless MATCHES "^(tool|never-shipped)$" AND NOT D_TOOLS))
            list(APPEND not_built "${key}")
            continue()
        endif()
        _runic_add_catalog_folder("${folder_${name}}" "${key}")
        list(APPEND added "${key}")
    endforeach()
    foreach(key IN LISTS interfaces)
        get_property(from GLOBAL PROPERTY "RUNIC_CATALOG_IFACE_${key}_FROM")
        if(NOT DEFINED folder_${from})
            runic_fatal("RUNIC: interface target ${key} comes FROM ${from}, which is not a module of the ${ns} catalog")
        endif()
        string(REGEX REPLACE "^[^:]+::" "" name "${key}")
        if(key IN_LIST selected AND EXISTS "${folder_${from}}/${name}/CMakeLists.txt")
            _runic_add_catalog_folder("${folder_${from}}/${name}" "${key}")
            list(APPEND added "${key}")
        endif()
    endforeach()
    set(umbrellas "")
    if(D_LAYOUT STREQUAL "GROUP")
        foreach(group IN LISTS groups)
            set(members "")
            foreach(key IN LISTS added)
                get_property(row_group GLOBAL PROPERTY "RUNIC_CATALOG_${key}_GROUP")
                if(row_group STREQUAL group)
                    list(APPEND members "${key}")
                endif()
            endforeach()
            if(members AND NOT TARGET "${ns}::${group}")
                runic_add_group(${group} MODULES ${members})
                list(APPEND umbrellas "${ns}::${group}")
            endif()
        endforeach()
    endif()

    foreach(list_name added umbrellas not_built)
        list(JOIN ${list_name} ", " ${list_name}_text)
        if(NOT ${list_name}_text)
            set(${list_name}_text "none")
        endif()
    endforeach()
    message(STATUS
        "RUNIC: ${ns} catalog: configured ${added_text}; groups ${umbrellas_text}; off in this build ${not_built_text}")
endfunction()

# add_subdirectory for one catalogued folder; its CMakeLists.txt must create the row's target.
function(_runic_add_catalog_folder folder key)
    file(RELATIVE_PATH rel "${CMAKE_CURRENT_SOURCE_DIR}" "${folder}")
    if(rel MATCHES "^\\.\\./" OR IS_ABSOLUTE "${rel}")
        string(MAKE_C_IDENTIFIER "${key}" slot)
        set(rel "_catalog/${slot}")
    endif()
    add_subdirectory("${folder}" "${CMAKE_CURRENT_BINARY_DIR}/${rel}")
    if(NOT TARGET "${key}")
        file(RELATIVE_PATH shown "${PROJECT_SOURCE_DIR}" "${folder}/CMakeLists.txt")
        runic_fatal(
            "RUNIC: ${shown} did not create ${key}: a module's CMakeLists.txt calls runic_add_module with its row's name (an interface target's, runic_add_interface_target)")
    endif()
endfunction()
