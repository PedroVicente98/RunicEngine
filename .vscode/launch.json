{
  // Each configuration first runs the task "Engine: build (debug)" and starts a program from build/debug/bin
  // under gdb. Names: the program, then what you get.
  "version": "0.2.0",
  "configurations": [
    {
      // The Engine's client: a Godot window with one button (slice 1 check 7). A key prints "AppEvent Key reached
      // the stack", a click beside the button prints "AppEvent MouseButton ...", a click on the button prints
      // nothing (Godot's UI keeps it). Close the window to stop.
      "name": "RunicClient: window with the test button",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/RunicClient",
      "args": [],
      "cwd": "${workspaceFolder}/build/debug/bin",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Engine: build (debug)",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
    },
    {
      // The Engine's server, no window: 120 frames (2 s) of the fixed 60 Hz loop. Test layers are pushed, replaced
      // and popped, and each prints the frame it attached or detached at (slice 1 check 2).
      "name": "RunicServer: 2-second run (layer demo)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/RunicServer",
      "args": ["--quit-after", "120", "--layer-demo"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Engine: build (debug)",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
    },
    {
      // The Godot editor (through LibGodot) on the Engine's small test project (tests/godot/SpikeProject, not RunicGame),
      // with the Runic test plugin: Project > Tools > "Runic: About this editor". RunicGame opens from its own launch.json.
      "name": "RunicEditor: open the Engine's test project",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/RunicEditor",
      "args": ["--editor", "--path", "${workspaceFolder}/build/debug/godot/SpikeProject"],
      "cwd": "${workspaceFolder}/build/debug/bin",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Engine: build (debug)",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "handle SIGPIPE nostop noprint pass", "ignoreFailures": true }
      ]
    },
    {
      // The editor with no project: Godot's Project Manager, to create or open a project.
      "name": "RunicEditor: Project Manager (new or open)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/RunicEditor",
      "args": [],
      "cwd": "${workspaceFolder}/build/debug/bin",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Engine: build (debug)",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "text": "handle SIGPIPE nostop noprint pass", "ignoreFailures": true }
      ]
    },
    {
      // The editor with no window on the Engine's test project; it quits after 120 frames. For debugging an editor that
      // fails to start: ctest runs the same check (godot.editor_spike).
      "name": "RunicEditor: startup check, no window",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/RunicEditor",
      "args": ["--headless", "--editor", "--path", "${workspaceFolder}/build/debug/godot/SpikeProject", "--quit-after", "120"],
      "cwd": "${workspaceFolder}/build/debug/bin",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Engine: build (debug)",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
    },
    {
      // RunicGodotBridgeTests (GoogleTest) under gdb, to step through a failing test; ctest runs them all anyway.
      "name": "GodotBridge: unit tests in the debugger",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/RunicGodotBridgeTests",
      "args": [],
      "cwd": "${workspaceFolder}/build/debug/bin",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Engine: build (debug)",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
    }
  ]
}
