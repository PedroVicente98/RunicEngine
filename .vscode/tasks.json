{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Engine: configure (debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Engine: build (debug)",
      "detail": "Helpers, godot-cpp, GodotBridge, GodotTools, the RunicEditor, the tests; libgodot (editor and template) is built from external/godot on the first build",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Engine: configure (debug)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Engine: build libgodot (editor and template)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "libgodot"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Engine: configure (debug)",
      "problemMatcher": []
    },
    {
      "label": "Engine: test (all)",
      "detail": "Module tests, the BUILD-1 acceptance tests, the scans and the Godot spike tests",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Engine: build (debug)",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Engine: test (Godot spike: editor and runtime)",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "godot"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Engine: build (debug)",
      "problemMatcher": []
    },
    {
      "label": "Engine: test (checks)",
      "detail": "Public-header scan, source-include scan, catalog sync, docs check, workflow pins",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "checks"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Engine: configure (debug)",
      "problemMatcher": []
    },
    {
      "label": "Engine: configure and build (headless)",
      "detail": "Proves the Engine configures and builds with no Godot and no graphics library",
      "type": "shell",
      "command": "cmake --preset headless && cmake --build --preset headless && ctest --preset headless",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
